{
  "name": "typescript-node",
  "description": "Node.js backend, CLI or library in TypeScript",
  "conflicts": [
    "typescript-react",
    "javascript"
  ],
  "common": [
    "node",
    "typescript"
  ],
  "codeql": "javascript-typescript",
  "checks": [
    "typescript-lint",
    "typescript-typecheck",
    "typescript-test",
    "typescript-quality",
    "typescript-build"
  ],
  "coverage": {
    "flag": "typescript",
    "paths": [
      "src/**"
    ],
    "uploads": 1
  },
  "setup": [
    "pnpm install",
    "pnpm exec prettier --log-level warn --write renovate.json .github/repo-standards.json",
    "pnpm exec husky"
  ],
  "check": "scripts/check-typescript.sh"
}
